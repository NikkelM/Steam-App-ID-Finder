	},
	"dependencies": {
		"@inquirer/prompts": "^8.5.2",
		"cli-progress": "^3.11.2",
		"commander": "^15.0.0",
		"jsonschema": "^1.4.1",
		"string-similarity": "^4.0.4"
	}
}
