		"steam-api",
		"steam-app-id",
		"app-id",
		"appid",
		"gog",
		"epic-games",
		"game-library",
		"game-names"
	],
	"author": {
		"name": "Nikkel Mollenhauer",
		"email": "contact@nikkelm.dev"
	},
	"license": "GPL-3.0-or-later",
	"homepage": "https://github.com/NikkelM/Steam-App-ID-Finder#readme",
	"main": "index.js",
	"bin": {
		"steam-app-id-finder": "bin/cli.js"
	},
	"files": [
		"bin/",
		"index.js",
		"js/",
		"config/config.schema.json",
		"config/schema.*.json",
		"config/*.default.json"
	],
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
